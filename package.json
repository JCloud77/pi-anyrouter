{
  "name": "@jcloud77/pi-anyrouter",
  "version": "0.4.0-alpha.2",
  "private": false,
  "type": "module",
  "description": "Unofficial pi provider extension for AnyRouter Claude Code and Codex Responses Lite routes",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "anyrouter",
    "claude",
    "claude-code",
    "codex",
    "openai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCloud77/pi-anyrouter.git"
  },
  "homepage": "https://github.com/JCloud77/pi-anyrouter#readme",
  "bugs": {
    "url": "https://github.com/JCloud77/pi-anyrouter/issues"
  },
  "files": [
    "index.ts",
    "src",
    "scripts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "capture:profile": "node scripts/capture-claude-profile.ts",
    "diagnose": "node scripts/diff-claude-requests.ts",
    "diagnose:environment": "node scripts/diagnose-environment.ts",
    "probe": "node scripts/probe-anyrouter.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "undici": "^8.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "typescript": "^5.9.3"
  }
}
